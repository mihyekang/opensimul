AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# SSL verification (set to false only in dev/test environments)
AZURE_OPENAI_VERIFY_SSL=true

# PostgreSQL (이미지 분석 결과 저장 — 없으면 DB 저장 생략)
POSTGRESQL_CONNECTION_STRING=postgresql://user:pass@host:5432/dbname?sslmode=require
